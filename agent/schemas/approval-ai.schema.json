{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "approval-ai.schema.json",
  "title": "pimoon AI approval",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "routine": {
      "type": "boolean",
      "description": "Skip AI for bounded local development operations."
    },
    "model": {
      "type": "string",
      "pattern": "^[^/]+/.+$"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 120000
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "max_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    }
  }
}
