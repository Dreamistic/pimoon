{
	"$schema": "../schemas/gui.schema.json",
	"theme": "system",
	"themeColor": "#A78BFA",
	"materials": {
		"enabled": true,
		"desktop": true,
		"canvas": { "opacity": 88, "darkOpacity": 92, "blur": 32, "saturation": 100 },
		"sidebar": { "opacity": 72, "darkOpacity": 86, "blur": 24, "saturation": 110 },
		"toolbar": { "opacity": 80, "darkOpacity": 90, "blur": 24, "saturation": 110 },
		"inspector": { "opacity": 86, "darkOpacity": 90, "blur": 24, "saturation": 110 },
		"composer": { "opacity": 88, "darkOpacity": 92, "blur": 20, "saturation": 110 },
		"floating": { "opacity": 86, "darkOpacity": 86, "blur": 24, "saturation": 110 },
		"dialog": { "opacity": 94, "darkOpacity": 96, "blur": 32, "saturation": 110 },
		"overlay": { "opacity": 32, "darkOpacity": 32, "blur": 4, "saturation": 100 }
	},
	"fonts": {
		"ui": [
			"LXGW WenKai",
			"霞鹜文楷"
		],
		"code": [
			"LXGW WenKai",
			"霞鹜文楷"
		]
	},
	"fontSizes": {
		"ui": 14,
		"chat": 16,
		"code": 14
	},
	"sendShortcut": "mod-enter",
	"openFileLinksExternally": false,
	"preventSleepWhileRunning": false,
	"desktopWeb": {
		"enabled": false,
		"host": "127.0.0.1",
		"port": 19218
	},
	"sessionCache": {
		"idleLimit": 3,
		"idleMs": 900000
	}
}
