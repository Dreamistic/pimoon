{
	"name": "pimoon",
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=24.0.0"
	},
	"type": "module",
	"private": true,
	"scripts": {
		"build": "bun run build:desktop",
		"build:tui": "bun scripts/build.mjs tui",
		"typecheck": "tsc",
		"test": "bun run build:tui && vitest run",
		"bench": "bun run build:tui && bun scripts/bench.mjs",
		"dev:tui": "bun src/tui/main.ts",
		"dev:web": "bun run build:gui && bun src/web/main.ts",
		"build:gui": "vite build --config vite.gui.config.ts",
		"build:web": "bun scripts/build.mjs web",
		"build:desktop": "python -X utf8 -B scripts/build-pimoon-runtime.py && bun scripts/build.mjs desktop --dir && node scripts/build-pimoon-portable.mjs",
		"desktop": "dist\\pimoon\\pimoon.exe",
		"test:gui": "bun scripts/build.mjs web && playwright test --config playwright.gui.config.ts",
		"test:desktop": "node tests/desktop/pimoon-smoke.mjs"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
